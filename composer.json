{
    "name": "leafs/billing",
    "description": "Leaf Billing API design",
    "keywords": [
        "billing",
        "payments",
        "leaf",
        "php"
    ],
    "homepage": "https://github.com/leafsphp/billing",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Darko",
            "email": "mickdd22@gmail.com",
            "homepage": "https://mychi.netlify.app",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Leaf\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "leafs/alchemy": "v5.x-dev",
        "friendsofphp/php-cs-fixer": "^3.66",
        "pestphp/pest": "*",
        "leafs/db": "*",
        "leafs/date": "*",
        "leafs/anchor": "^1.6"
    },
    "require": {
        "php": "^8.2",
        "leafs/sprout": "*"
    },
    "scripts": {
        "alchemy": "@php vendor/bin/alchemy all",
        "test": "@php vendor/bin/alchemy test",
        "lint": "@php vendor/bin/alchemy lint",
        "fmt": "@php vendor/bin/alchemy fmt",
        "analyse": "@php vendor/bin/alchemy analyse",
        "refactor": "@php vendor/bin/alchemy refactor",
        "ci": "@php vendor/bin/alchemy ci"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
